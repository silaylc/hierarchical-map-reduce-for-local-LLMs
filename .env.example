# Copy this file to `.env` and fill in the paths for your own machine.
# `.env` itself is git-ignored -- only this example file is committed.

# Absolute path to your local model directory (mounted read-only into the vllm container as /model)
MODEL_PATH=/path/to/your/model

# Absolute path to the folder you want the API service to read/write documents in
# (defaults to ./documents if left unset)
DOCUMENTS_PATH=./documents

# Must match the --max-model-len value the LLM backend is actually launched with
LLM_MAX_MODEL_LEN=4096
